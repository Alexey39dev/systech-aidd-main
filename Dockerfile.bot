FROM python:3.11-slim

WORKDIR /app

# Установка UV
RUN pip install uv

# Копирование файлов проекта
COPY pyproject.toml .
COPY README.md .
COPY src/ ./src/
COPY prompts/ ./prompts/
COPY alembic/ ./alembic/
COPY alembic.ini .

# Установка зависимостей через UV
RUN uv pip install --system -e .

# Запуск бота
CMD ["python", "-m", "src.main"]
