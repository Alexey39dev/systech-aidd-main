FROM node:20-alpine

WORKDIR /app

# Установка pnpm
RUN npm install -g pnpm

# Копирование конфигурационных файлов
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/tsconfig.json frontend/next.config.js frontend/tailwind.config.ts frontend/postcss.config.js ./

# Установка зависимостей
RUN pnpm install

# Копирование исходного кода
COPY frontend/app ./app
COPY frontend/components ./components
COPY frontend/hooks ./hooks
COPY frontend/lib ./lib
COPY frontend/types ./types
COPY frontend/public ./public

# Копирование остальных файлов
COPY frontend/components.json ./
# next-env.d.ts может не существовать, копируем только если есть
COPY frontend/next-env.d.ts* ./

# Открытие порта
EXPOSE 3000

# Запуск в dev режиме (для MVP)
CMD ["pnpm", "dev"]
