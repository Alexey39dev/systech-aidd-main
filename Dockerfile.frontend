FROM node:20-alpine

WORKDIR /app

# Установка pnpm
RUN npm install -g pnpm

# Копирование package.json и pnpm-lock.yaml
COPY frontend/package.json frontend/pnpm-lock.yaml ./

# Установка зависимостей
RUN pnpm install

# Копирование остальных файлов frontend
COPY frontend/ .

# Открытие порта
EXPOSE 3000

# Запуск в dev режиме (для MVP)
CMD ["pnpm", "dev"]
