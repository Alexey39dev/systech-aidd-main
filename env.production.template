# =============================================================================
# ПРОИЗВОДСТВЕННАЯ КОНФИГУРАЦИЯ SYSTECH-AIDD
# =============================================================================
# Этот файл содержит все необходимые переменные окружения для production
# развертывания на сервере 89.223.67.136
#
# ИНСТРУКЦИЯ:
# 1. Скопируйте этот файл в .env
# 2. Заполните все значения, помеченные как "ЗАПОЛНИТЬ"
# 3. Убедитесь, что все секреты защищены
# =============================================================================

# =============================================================================
# OPENROUTER API КОНФИГУРАЦИЯ
# =============================================================================
# API ключ для доступа к OpenRouter (обязательно)
# Получить можно на https://openrouter.ai/
OPENROUTER_API_KEY=ЗАПОЛНИТЬ_ВАШ_OPENROUTER_API_KEY

# =============================================================================
# LLM КОНФИГУРАЦИЯ
# =============================================================================
# Системный промпт для ассистента (по умолчанию)
SYSTEM_PROMPT=Ты полезный ассистент. Отвечай на вопросы пользователя дружелюбно и информативно.

# Путь к файлу с системным промптом (переопределяет SYSTEM_PROMPT)
# Пример: prompts/tech_support.txt
SYSTEM_PROMPT_FILE=

# Максимальная длина истории диалога (1-50)
MAX_HISTORY=10

# Модель LLM для использования
LLM_MODEL=openai/gpt-3.5-turbo

# Температура для генерации (0.0-2.0)
LLM_TEMPERATURE=0.7

# Максимальное количество токенов в ответе (100-4000)
LLM_MAX_TOKENS=1000

# =============================================================================
# БАЗА ДАННЫХ POSTGRESQL
# =============================================================================
# URL подключения к базе данных PostgreSQL
# Формат: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://aidd_user:ЗАПОЛНИТЬ_ПАРОЛЬ_БД@postgres:5432/aidd_db

# Минимальный размер пула соединений (1-50)
DATABASE_POOL_MIN_SIZE=5

# Максимальный размер пула соединений (1-100)
DATABASE_POOL_MAX_SIZE=20

# =============================================================================
# ЛОГИРОВАНИЕ
# =============================================================================
# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Включить запись логов в файл
LOG_TO_FILE=true

# Путь к файлу логов
LOG_FILE_PATH=/app/logs/app.log

# Цветной вывод в консоль
LOG_COLORFUL=true

# =============================================================================
# API СЕРВЕР
# =============================================================================
# Хост для API сервера (0.0.0.0 для всех интерфейсов)
API_HOST=0.0.0.0

# Порт для API сервера (production: 8002)
API_PORT=8002

# Автоперезагрузка при изменении кода (false для production)
API_RELOAD=false

# Тип сборщика статистики (mock или real)
STAT_COLLECTOR_TYPE=real

# =============================================================================
# ЧАТ И СЕССИИ
# =============================================================================
# Включить API чата
CHAT_ENABLED=true

# Включить режим администратора с text-to-SQL
TEXT_TO_SQL_ENABLED=true

# Время жизни сессии в часах (1-168)
SESSION_EXPIRE_HOURS=24

# =============================================================================
# BOT КОНФИГУРАЦИЯ
# =============================================================================
# Имя пользователя бота в Docker контейнере
BOT_USERNAME=docker-user

# =============================================================================
# TELEGRAM BOT (если используется)
# =============================================================================
# Токен Telegram бота (если нужен)
TELEGRAM_BOT_TOKEN=ЗАПОЛНИТЬ_ЕСЛИ_НУЖЕН

# =============================================================================
# PRODUCTION НАСТРОЙКИ
# =============================================================================
# Окружение (production, development, testing)
ENVIRONMENT=production

# Домен для CORS (замените на ваш домен)
CORS_ORIGINS=http://89.223.67.136:3002,http://localhost:3002

# =============================================================================
# БЕЗОПАСНОСТЬ
# =============================================================================
# Секретный ключ для подписи JWT токенов (сгенерируйте случайную строку)
JWT_SECRET_KEY=ЗАПОЛНИТЬ_СЛУЧАЙНУЮ_СТРОКУ_32_СИМВОЛА

# Соль для хеширования паролей
PASSWORD_SALT=ЗАПОЛНИТЬ_СЛУЧАЙНУЮ_СТРОКУ_16_СИМВОЛОВ

# =============================================================================
# МОНИТОРИНГ И HEALTH CHECKS
# =============================================================================
# Включить health check endpoint
HEALTH_CHECK_ENABLED=true

# Интервал проверки здоровья сервисов (секунды)
HEALTH_CHECK_INTERVAL=30

# =============================================================================
# ПРИМЕРЫ ЗНАЧЕНИЙ ДЛЯ ЗАПОЛНЕНИЯ
# =============================================================================
# 
# OPENROUTER_API_KEY=sk-or-v1-1234567890abcdef...
# POSTGRES_PASSWORD=SecurePassword123!
# TELEGRAM_BOT_TOKEN=1234567890:ABCDEFghijklmnop...
# JWT_SECRET_KEY=my-super-secret-jwt-key-32-chars
# PASSWORD_SALT=my-salt-16-chars
#
# =============================================================================