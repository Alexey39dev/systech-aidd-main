# =============================================================================
# РљРѕРЅС„РёРіСѓСЂР°С†РёСЏ РїСЂРѕРµРєС‚Р° systech-aidd
# =============================================================================
# РЎРєРѕРїРёСЂСѓР№С‚Рµ СЌС‚РѕС‚ С„Р°Р№Р» РІ .env Рё РЅР°СЃС‚СЂРѕР№С‚Рµ Р·РЅР°С‡РµРЅРёСЏ РїРѕРґ РІР°С€Рµ РѕРєСЂСѓР¶РµРЅРёРµ
# cp .env.example .env

# =============================================================================
# OpenRouter API Configuration
# =============================================================================
# API РєР»СЋС‡ РѕС‚ OpenRouter РґР»СЏ РґРѕСЃС‚СѓРїР° Рє LLM РјРѕРґРµР»СЏРј
# РџРѕР»СѓС‡РёС‚СЊ РјРѕР¶РЅРѕ РЅР°: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# =============================================================================
# LLM Configuration
# =============================================================================
# РЎРёСЃС‚РµРјРЅС‹Р№ РїСЂРѕРјРїС‚ РґР»СЏ LLM Р°СЃСЃРёСЃС‚РµРЅС‚Р°
SYSTEM_PROMPT=РўС‹ РїРѕР»РµР·РЅС‹Р№ Р°СЃСЃРёСЃС‚РµРЅС‚. РћС‚РІРµС‡Р°Р№ РЅР° РІРѕРїСЂРѕСЃС‹ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ РґСЂСѓР¶РµР»СЋР±РЅРѕ Рё РёРЅС„РѕСЂРјР°С‚РёРІРЅРѕ.

# Р¤Р°Р№Р» СЃ СЃРёСЃС‚РµРјРЅС‹Рј РїСЂРѕРјРїС‚РѕРј (РµСЃР»Рё РёСЃРїРѕР»СЊР·СѓРµС‚СЃСЏ С„Р°Р№Р» РІРјРµСЃС‚Рѕ РїРµСЂРµРјРµРЅРЅРѕР№)
# SYSTEM_PROMPT_FILE=

# РњР°РєСЃРёРјР°Р»СЊРЅРѕРµ РєРѕР»РёС‡РµСЃС‚РІРѕ СЃРѕРѕР±С‰РµРЅРёР№ РІ РёСЃС‚РѕСЂРёРё РґРёР°Р»РѕРіР°
MAX_HISTORY=10

# РњРѕРґРµР»СЊ LLM РґР»СЏ РёСЃРїРѕР»СЊР·РѕРІР°РЅРёСЏ (РґРѕСЃС‚СѓРїРЅС‹Рµ РјРѕРґРµР»Рё РЅР° openrouter.ai)
LLM_MODEL=openai/gpt-3.5-turbo

# РўРµРјРїРµСЂР°С‚СѓСЂР° РіРµРЅРµСЂР°С†РёРё (0.0 - РґРµС‚РµСЂРјРёРЅРёСЂРѕРІР°РЅРЅРѕ, 1.0 - РєСЂРµР°С‚РёРІРЅРѕ)
LLM_TEMPERATURE=0.7

# РњР°РєСЃРёРјР°Р»СЊРЅРѕРµ РєРѕР»РёС‡РµСЃС‚РІРѕ С‚РѕРєРµРЅРѕРІ РІ РѕС‚РІРµС‚Рµ
LLM_MAX_TOKENS=1000

# =============================================================================
# Database Configuration
# =============================================================================
# URL РїРѕРґРєР»СЋС‡РµРЅРёСЏ Рє PostgreSQL Р±Р°Р·Рµ РґР°РЅРЅС‹С…
# Р¤РѕСЂРјР°С‚: postgresql://username:password@host:port/database
# Р”Р»СЏ Docker: postgres - РёРјСЏ СЃРµСЂРІРёСЃР° РІ docker-compose.yml
DATABASE_URL=postgresql://aidd_user:aidd_password@postgres:5432/aidd_db

# РњРёРЅРёРјР°Р»СЊРЅС‹Р№ СЂР°Р·РјРµСЂ РїСѓР»Р° РїРѕРґРєР»СЋС‡РµРЅРёР№ Рє Р‘Р”
DATABASE_POOL_MIN_SIZE=5

# РњР°РєСЃРёРјР°Р»СЊРЅС‹Р№ СЂР°Р·РјРµСЂ РїСѓР»Р° РїРѕРґРєР»СЋС‡РµРЅРёР№ Рє Р‘Р”
DATABASE_POOL_MAX_SIZE=20

# =============================================================================
# Logging Configuration
# =============================================================================
# РЈСЂРѕРІРµРЅСЊ Р»РѕРіРёСЂРѕРІР°РЅРёСЏ (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Р—Р°РїРёСЃС‹РІР°С‚СЊ Р»Рё Р»РѕРіРё РІ С„Р°Р№Р» (true/false)
LOG_TO_FILE=false

# РџСѓС‚СЊ Рє С„Р°Р№Р»Сѓ Р»РѕРіРѕРІ (РµСЃР»Рё LOG_TO_FILE=true)
LOG_FILE_PATH=logs/app.log

# Р¦РІРµС‚РЅРѕР№ РІС‹РІРѕРґ РІ РєРѕРЅСЃРѕР»СЊ (true/false)
LOG_COLORFUL=true

# =============================================================================
# API Configuration
# =============================================================================
# РҐРѕСЃС‚ РґР»СЏ API СЃРµСЂРІРµСЂР° (0.0.0.0 РґР»СЏ Docker, 127.0.0.1 РґР»СЏ Р»РѕРєР°Р»СЊРЅРѕР№ СЂР°Р·СЂР°Р±РѕС‚РєРё)
API_HOST=0.0.0.0

# РџРѕСЂС‚ РґР»СЏ API СЃРµСЂРІРµСЂР°
API_PORT=8000

# РђРІС‚РѕРјР°С‚РёС‡РµСЃРєР°СЏ РїРµСЂРµР·Р°РіСЂСѓР·РєР° РїСЂРё РёР·РјРµРЅРµРЅРёРё РєРѕРґР° (true/false)
# Р”Р»СЏ production РґРѕР»Р¶РЅРѕ Р±С‹С‚СЊ false
API_RELOAD=false

# РўРёРї СЃР±РѕСЂС‰РёРєР° СЃС‚Р°С‚РёСЃС‚РёРєРё (mock - С‚РµСЃС‚РѕРІС‹Рµ РґР°РЅРЅС‹Рµ, real - СЂРµР°Р»СЊРЅР°СЏ СЃС‚Р°С‚РёСЃС‚РёРєР°)
STAT_COLLECTOR_TYPE=mock

# =============================================================================
# Chat Configuration
# =============================================================================
# Р’РєР»СЋС‡РёС‚СЊ Р»Рё API РґР»СЏ С‡Р°С‚Р° (true/false)
CHAT_ENABLED=true

# Р’РєР»СЋС‡РёС‚СЊ Р»Рё СЂРµР¶РёРј Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂР° СЃ text-to-SQL (true/false)
TEXT_TO_SQL_ENABLED=true

# Р’СЂРµРјСЏ Р¶РёР·РЅРё СЃРµСЃСЃРёРё РІ С‡Р°СЃР°С… (1-168)
SESSION_EXPIRE_HOURS=24

# =============================================================================
# Bot Configuration
# =============================================================================
# РРјСЏ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ РґР»СЏ Р±РѕС‚Р° РІ Docker РєРѕРЅС‚РµР№РЅРµСЂРµ
# Р’ РёРЅС‚РµСЂР°РєС‚РёРІРЅРѕРј СЂРµР¶РёРјРµ Р·Р°РїСЂР°С€РёРІР°РµС‚СЃСЏ Сѓ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ
BOT_USERNAME=docker-user

# =============================================================================
# Frontend Configuration
# =============================================================================
# URL API СЃРµСЂРІРµСЂР° РґР»СЏ Frontend (Next.js)
# Р”Р»СЏ Docker: http://api:8000 (РІРЅСѓС‚СЂРµРЅРЅРёР№ DNS)
# Р”Р»СЏ Р»РѕРєР°Р»СЊРЅРѕР№ СЂР°Р·СЂР°Р±РѕС‚РєРё: http://localhost:8000
NEXT_PUBLIC_API_URL=http://api:8000

# =============================================================================
# Docker Configuration (Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРё РѕРїСЂРµРґРµР»СЏРµС‚СЃСЏ)
# =============================================================================
# Р­С‚Рё РїРµСЂРµРјРµРЅРЅС‹Рµ СѓСЃС‚Р°РЅР°РІР»РёРІР°СЋС‚СЃСЏ Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРё РІ Docker РєРѕРЅС‚РµР№РЅРµСЂР°С…
# РќРµ РёР·РјРµРЅСЏР№С‚Рµ РёС… РІСЂСѓС‡РЅСѓСЋ

